# Copy to .env.local (gitignored) and fill in. Never commit .env.local.

# reCAPTCHA Enterprise site key used by Firebase App Check (public; score-based Web key,
# "checkbox challenge" off, localhost allowed for dev).
VITE_RECAPTCHA_ENTERPRISE_KEY=

# App Check DEBUG token. Used only by `npm run dev` (never in production builds).
# Leave empty on first run: the browser console prints a token; register it in
# Firebase console → Security → App Check → Apps → ⋮ → Manage debug tokens,
# then paste it here so it stays the same across browsers/profiles.
VITE_APPCHECK_DEBUG_TOKEN=
